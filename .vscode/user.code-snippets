{
	// Place your UtahMarchingHub workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"user": {
		"scope": "html",
		"prefix": ["user", "credit", "school"],
		"body": [
			"<div class=\"user\">",
			"    <a target=\"_blank\" href=\"https://github.com/$2\" class=\"user-icon\">",
			"        <img src=\"$1\"></img>",
			"    </a>",
			"    <a target=\"_blank\" class=\"user-link\" href=\"https://github.com/$2\">$2</a>",
			"    <div class=\"socials\">",
			"        <a target=\"_blank\" href=\"https://github.com/$2/\" class=\"github\"></a>",
			"        <a target=\"_blank\" href=\"$3\" class=\"site\"></a>",
			"        <a target=\"_blank\" href=\"${4:https://youtube.com/}\" class=\"youtube\"></a>",
			"        <a target=\"_blank\" href=\"${5:https://twitch.tv/}\" class=\"twitch\"></a>",
			"        <a target=\"_blank\" href=\"${6:https://twitter.com/}\" class=\"twitter\"></a>",
			"        <a target=\"_blank\" href=\"${7:https://instagram.com/}\" class=\"instagram\"></a>",
			"    </div>",
			"</div>",
		],
		"description": "A user section for credits or for a school (remove github links for school). The socials are optional."
	}
}