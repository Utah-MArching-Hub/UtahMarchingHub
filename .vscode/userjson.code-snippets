	"User JSON" : {
		"scope": "json",
		"prefix": ["credit"],
		"body": [
			"\"$1\" : {",
			"    \"icon\" : \"$2\",",
			"    \"url\" : \"https://github.com/$1\",",
			"    \"socials\" : [",
			"        [\"github\" , \"$1\"],",
			"        ${0:social}",
			"    ]",
			"}",
		],
		"description": "Section of json for the credits page or schools page. To not include a social link, just leave the value blank."
	}
}